{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/q-network-protocol/schemas/question-graph-v0.3.schema.json",

  "title": "Q Network Protocol Question Graph v0.3",
  "description": "Schema for representing explicit relationships between Question Envelopes in Q Network Protocol v0.3.",

  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "graph_id",
    "created_at",
    "graph_status",
    "nodes",
    "edges"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.3.0",
      "description": "Schema version for this Question Graph."
    },

    "graph_id": {
      "$ref": "#/$defs/graphId"
    },

    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp indicating when the Question Graph record was created."
    },

    "graph_status": {
      "type": "string",
      "enum": [
        "open",
        "stable",
        "closed",
        "partial",
        "invalid"
      ],
      "description": "Current graph-level lifecycle or integrity state."
    },

    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/questionId"
      },
      "description": "Question identifiers participating in this graph."
    },

    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/questionEdge"
      },
      "description": "Directed relationships between Question Envelope identifiers."
    }
  },

  "$defs": {
    "graphId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identifier for a Question Graph."
    },

    "questionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Identifier of a Question Envelope."
    },

    "edgeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Identifier of a Question Graph edge."
    },

    "relation": {
      "type": "string",
      "enum": [
        "derived",
        "decomposed_into",
        "interpreted_as",
        "clarified_by",
        "verified_by",
        "audited_by",
        "recovered_by",
        "routed_to",
        "superseded_by",
        "unresolved_into"
      ],
      "description": "Directed semantic or operational relationship between two questions."
    },

    "questionEdge": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "edge_id",
        "from_question_id",
        "to_question_id",
        "relation"
      ],

      "properties": {
        "edge_id": {
          "$ref": "#/$defs/edgeId"
        },

        "from_question_id": {
          "$ref": "#/$defs/questionId"
        },

        "to_question_id": {
          "$ref": "#/$defs/questionId"
        },

        "relation": {
          "$ref": "#/$defs/relation"
        }
      }
    }
  }
}
