{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/q-network-protocol/schemas/question-envelope-v0.1.schema.json",
  "title": "Q Network Protocol Question Envelope v0.1",
  "description": "Schema for a minimal interoperable Question Envelope used to represent, derive, route, and trace questions across AI agents, models, software systems, and human participants.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "question_id",
    "created_at",
    "question_origin",
    "question_type",
    "intent",
    "domain",
    "risk_level",
    "authority",
    "status"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Schema version for this Question Envelope."
    },

    "question_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identifier for the question."
    },

    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp indicating when the Question Envelope was created."
    },

    "question_origin": {
      "type": "string",
      "enum": [
        "external",
        "internal",
        "derived",
        "audit",
        "recovery"
      ],
      "description": "Describes how the question entered the Q Network."
    },

    "question_type": {
      "type": "string",
      "enum": [
        "request",
        "subquestion",
        "verification",
        "clarification",
        "decision",
        "recovery"
      ],
      "description": "Functional role of the question."
    },

    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Concise purpose or intended outcome of the question."
    },

    "domain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": "One or more subject or operational domains relevant to the question."
    },

    "context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Optional contextual information needed to interpret the question."
    },

    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Potential impact associated with processing or acting on the question."
    },

    "authority": {
      "$ref": "#/$defs/authority"
    },

    "status": {
      "type": "string",
      "enum": [
        "created",
        "routed",
        "accepted",
        "in_progress",
        "answered",
        "held",
        "rejected",
        "expired",
        "unresolved"
      ],
      "description": "Current lifecycle state of the question."
    },

    "parent_question_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Immediate parent question in a decomposition relationship."
    },

    "derived_from": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Question identifier from which this question was semantically derived."
    },

    "assigned_to": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256,
      "description": "Identifier of the current intended processor."
    },

    "trace_parent": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512,
      "description": "Reference to an external trace, provenance, receipt, or observability record."
    }
  },

  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Whether separate authorization is required before an associated action may execute."
        }
      },
      "description": "Authority metadata. Presence of the Question Envelope never grants authority."
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "question_origin": {
            "const": "derived"
          }
        },
        "required": [
          "question_origin"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "parent_question_id"
            ],
            "properties": {
              "parent_question_id": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "derived_from"
            ],
            "properties": {
              "derived_from": {
                "type": "string"
              }
            }
          }
        ]
      }
    },

    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "routed",
              "accepted",
              "in_progress"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "assigned_to"
        ],
        "properties": {
          "assigned_to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
