{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/q-network-protocol/schemas/question-envelope-v0.2.schema.json",
  "title": "Q Network Protocol Question Envelope v0.2",
  "description": "Question Envelope schema for Q Network Protocol v0.2 with explicit Question Provenance metadata.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "question_id",
    "created_at",
    "question_origin",
    "question_type",
    "intent",
    "domain",
    "risk_level",
    "authority",
    "status"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0",
      "description": "Schema version for this Question Envelope."
    },

    "question_id": {
      "$ref": "#/$defs/questionId"
    },

    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp indicating when the Question Envelope was created."
    },

    "question_origin": {
      "type": "string",
      "enum": [
        "external",
        "internal",
        "derived",
        "audit",
        "recovery"
      ],
      "description": "Describes how the question entered the Q Network."
    },

    "question_type": {
      "type": "string",
      "enum": [
        "request",
        "subquestion",
        "verification",
        "clarification",
        "decision",
        "recovery"
      ],
      "description": "Functional role of the question."
    },

    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Concise purpose or intended outcome of the question."
    },

    "domain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": "One or more subject or operational domains relevant to the question."
    },

    "context": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional contextual information needed to interpret the question."
    },

    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Potential impact associated with processing or acting on the question."
    },

    "authority": {
      "$ref": "#/$defs/authority"
    },

    "status": {
      "type": "string",
      "enum": [
        "created",
        "routed",
        "accepted",
        "in_progress",
        "answered",
        "held",
        "rejected",
        "expired",
        "unresolved"
      ],
      "description": "Current lifecycle state of the question."
    },

    "parent_question_id": {
      "$ref": "#/$defs/nullableQuestionId"
    },

    "derived_from": {
      "$ref": "#/$defs/nullableQuestionId"
    },

    "assigned_to": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ],
      "description": "Identifier of the current intended processor."
    },

    "trace_parent": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ],
      "description": "Reference to an external trace, provenance, receipt, or observability record."
    },

    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/provenance"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional provenance metadata describing why and how this question was generated."
    }
  },

  "$defs": {
    "questionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identifier for a Question Envelope."
    },

    "nullableQuestionId": {
      "anyOf": [
        {
          "$ref": "#/$defs/questionId"
        },
        {
          "type": "null"
        }
      ]
    },

    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Whether separate authorization is required before an associated action may execute."
        }
      },
      "description": "Authority metadata. Presence of the Question Envelope never grants execution authority."
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "trigger_event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Observable event that triggered generation of the question."
        },

        "generated_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Actor or component responsible for generating the question."
        },

        "generation_reason": {
          "type": "string",
          "enum": [
            "interpretation",
            "decomposition",
            "clarification",
            "verification",
            "audit",
            "recovery",
            "escalation",
            "risk_review",
            "authority_check",
            "dependency_check"
          ],
          "description": "Functional reason why the new question was generated."
        },

        "source_question_id": {
          "$ref": "#/$defs/questionId"
        },

        "source_intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Intent associated with the provenance source at generation time."
        },

        "interpreted_intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Intent inferred or reformulated by the component generating the current question."
        },

        "authority_context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Reference to authority context relevant when the question was generated. This reference does not itself grant authority."
        },

        "provenance_trace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Reference to an external trace or receipt describing the question-generation event."
        }
      },

      "minProperties": 1,

      "dependentRequired": {
        "generation_reason": [
          "generated_by"
        ],
        "interpreted_intent": [
          "source_intent"
        ]
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "question_origin": {
            "const": "derived"
          }
        },
        "required": [
          "question_origin"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "parent_question_id"
            ],
            "properties": {
              "parent_question_id": {
                "$ref": "#/$defs/questionId"
              }
            }
          },
          {
            "required": [
              "derived_from"
            ],
            "properties": {
              "derived_from": {
                "$ref": "#/$defs/questionId"
              }
            }
          }
        ]
      }
    },

    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "routed",
              "accepted",
              "in_progress"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "assigned_to"
        ],
        "properties": {
          "assigned_to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },

    {
      "if": {
        "properties": {
          "question_origin": {
            "enum": [
              "derived",
              "audit",
              "recovery"
            ]
          }
        },
        "required": [
          "question_origin"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "anyOf": [
              {
                "$ref": "#/$defs/provenance"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  ]
}
