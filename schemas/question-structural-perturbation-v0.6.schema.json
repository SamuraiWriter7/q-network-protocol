{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/q-network-protocol/schemas/question-structural-perturbation-v0.6.schema.json",

  "title": "Q Network Protocol Question Structural Perturbation v0.6",
  "description": "Schema for recording observable structural effects produced by a question in Q Network Protocol v0.6.",

  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "perturbation_id",
    "created_at",
    "question_id",
    "signals",
    "classification",
    "review_state"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.6.0"
    },

    "perturbation_id": {
      "$ref": "#/$defs/identifier"
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "question_id": {
      "$ref": "#/$defs/identifier"
    },

    "signals": {
      "$ref": "#/$defs/signals"
    },

    "affected_assumptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },

    "generated_question_count": {
      "type": "integer",
      "minimum": 0
    },

    "downstream_question_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },

    "downstream_structure_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },

    "classification": {
      "$ref": "#/$defs/classification"
    },

    "review_state": {
      "$ref": "#/$defs/reviewState"
    },

    "detected_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },

    "detection_method": {
      "$ref": "#/$defs/detectionMethod"
    },

    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },

    "trace_parent": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },

    "local_score": {
      "$ref": "#/$defs/localScore"
    }
  },

  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },

    "signals": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "assumption_changed",
        "problem_frame_changed",
        "design_target_changed",
        "reversal_detected",
        "new_questions_generated",
        "new_structure_generated"
      ],

      "properties": {
        "assumption_changed": {
          "type": "boolean"
        },

        "problem_frame_changed": {
          "type": "boolean"
        },

        "design_target_changed": {
          "type": "boolean"
        },

        "reversal_detected": {
          "type": "boolean"
        },

        "new_questions_generated": {
          "type": "boolean"
        },

        "new_structure_generated": {
          "type": "boolean"
        }
      }
    },

    "classification": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "structural"
      ]
    },

    "reviewState": {
      "type": "string",
      "enum": [
        "none",
        "observe",
        "structural_review_recommended",
        "independent_review_recommended",
        "human_review_required"
      ]
    },

    "detectionMethod": {
      "type": "string",
      "enum": [
        "structural",
        "rule_based",
        "semantic",
        "hybrid",
        "human"
      ]
    },

    "localScore": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "value",
        "method"
      ],

      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },

  "dependentRequired": {
    "detected_by": [
      "detection_method"
    ],
    "local_score": [
      "detection_method"
    ]
  }
}
